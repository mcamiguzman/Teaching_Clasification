# Configuración de entorno — API y App de Retroalimentación Estudiantil
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# [Parte 1.6 — Seguridad] Clave opcional para endpoints administrativos
# (switch/rollback de versiones). Si está vacía en desarrollo local, se permite
# el acceso con advertencia; en producción SIEMPRE definir un valor robusto.
ADMIN_API_KEY=dev-secret-change-in-production

# [Parte 2.4 — Compatibilidad de versiones]
# "true" bloquea el arranque si la versión de scikit-learn difiere de la de entrenamiento;
# "false" registra advertencia y continúa si la carga es compatible.
STRICT_VERSION_CHECK=false

# [Parte 1.6 — Límites de entrada y monitoreo]
MAX_COMMENT_LENGTH=3000
MAX_BATCH_SIZE=500
MAX_CSV_ROWS=5000
DRIFT_PSI_WARNING=0.10
DRIFT_PSI_CRITICAL=0.25
